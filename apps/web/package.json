{
  "name": "@finance/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React 19 + Vite SPA: login form and a /me page showing the user and API health.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build --workspace @finance/contracts",
    "dev": "vite",
    "prebuild": "npm run build --workspace @finance/contracts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @finance/contracts",
    "test": "vitest run"
  },
  "dependencies": {
    "@finance/contracts": "*",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  }
}
