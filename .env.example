# Copy to `.env` and fill in. Config is Zod-validated at boot (FR12);
# anything invalid is a fatal error before the port is bound.

# HTTP port for the API (apps/api). Web dev server is Vite's default 5173.
PORT=3000

# development | test | production
NODE_ENV=development

# SQLite file path. Tests override this with `:memory:`.
DB_PATH=./data/finance.db

# REQUIRED — no default. HS256 signing key for access tokens.
# FATAL BOOT ERROR if missing or shorter than 32 characters: config.ts throws
# and the process exits non-zero without binding the port.
JWT_SECRET=

# Access-token lifetime (JWT, HS256).
ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime (opaque, DB-backed, rotated on every use).
REFRESH_TOKEN_TTL=30d

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Seed identity (read ONLY by `db:seed`) ----------------------------------
# The seed script's defaults are the published pair `owner@example.com` /
# `change-me-please-123`. That was fine while the app ran on localhost only.
# Set both before seeding any deployment another machine can reach — nothing
# rate-limits `/auth/*` (docs/deferred.md), so a known credential is a known
# way in. Changing these AFTER seeding creates a second user; it does not
# rename the first.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Docker -----------------------------------------------------------------
# `docker-compose.yml` reads this file, but overrides DB_PATH (to /data/finance.db,
# the named volume) and NODE_ENV (to production), so the values above stay correct
# for local `npm run dev`. The container runs `node dist/index.js` directly, NOT
# through npm, so Node's `--env-file-if-exists` is not involved: every variable
# comes from compose. See docs/gotchas.md.

# --- Cloudflare Access (ADR 0010) --------------------------------------------
# In production the app sits behind a Cloudflare Tunnel with Cloudflare Access in
# front of the hostname. Access authenticates the user at the edge and injects a
# signed RS256 JWT as `Cf-Access-Jwt-Assertion` on every proxied request; the API
# verifies it against the team's JWKS and maps the `email` claim to a user,
# creating one on first sight.
#
# LEAVE THIS OFF LOCALLY. With CF_ACCESS_ENABLED=false the header is ignored
# outright — not merely unverified — so `npm run dev` keeps using email/password
# login, which is also what any future CLI or mobile client will use.
CF_ACCESS_ENABLED=false

# REQUIRED when CF_ACCESS_ENABLED=true; both are a FATAL BOOT ERROR if missing.
# That is deliberate: a box that believes Access is on but silently fell back to
# password-only looks identical from outside to a working one.
#
# Team domain: a BARE HOSTNAME, no scheme and no trailing slash. The issuer
# (`https://<domain>`) and the JWKS URL (`.../cdn-cgi/access/certs`) are derived
# from it, so a scheme here yields an issuer that can never match a token.
# Find it in Zero Trust → Settings → Custom Pages, or in the redirect you get
# from `curl -sI https://<your-host>/`.
CF_ACCESS_TEAM_DOMAIN=

# The Access APPLICATION audience tag: 64 lowercase hex characters. Validated by
# shape, because it is the only claim scoping a token to THIS application — a
# token minted for another app in the same Zero Trust account is otherwise
# perfectly valid and correctly signed. Zero Trust → Access → Applications →
# your app → Overview → Application Audience (AUD) Tag.
CF_ACCESS_AUD=
