# Copy to `.env` and fill in. Config is Zod-validated at boot (FR12);
# anything invalid is a fatal error before the port is bound.

# HTTP port for the API (apps/api). Web dev server is Vite's default 5173.
PORT=3000

# development | test | production
NODE_ENV=development

# SQLite file path. Tests override this with `:memory:`.
DB_PATH=./data/finance.db

# REQUIRED — no default. HS256 signing key for access tokens.
# FATAL BOOT ERROR if missing or shorter than 32 characters: config.ts throws
# and the process exits non-zero without binding the port.
JWT_SECRET=

# Access-token lifetime (JWT, HS256).
ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime (opaque, DB-backed, rotated on every use).
REFRESH_TOKEN_TTL=30d

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Seed identity (read ONLY by `db:seed`) ----------------------------------
# The seed script's defaults are the published pair `owner@example.com` /
# `change-me-please-123`. That was fine while the app ran on localhost only.
# Set both before seeding any deployment another machine can reach — nothing
# rate-limits `/auth/*` (docs/deferred.md), so a known credential is a known
# way in. Changing these AFTER seeding creates a second user; it does not
# rename the first.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Docker -----------------------------------------------------------------
# `docker-compose.yml` reads this file, but overrides DB_PATH (to /data/finance.db,
# the named volume) and NODE_ENV (to production), so the values above stay correct
# for local `npm run dev`. The container runs `node dist/index.js` directly, NOT
# through npm, so Node's `--env-file-if-exists` is not involved: every variable
# comes from compose. See docs/gotchas.md.
